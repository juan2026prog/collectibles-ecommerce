{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/((?!api/|admin|vendor|artist|affiliate|star2fan|checkout|account|assets/|images/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/brand/:slug*",
      "destination": "/marca/:slug*",
      "permanent": true
    },
    {
      "source": "/product-category/:slug*",
      "destination": "/categoria/:slug*",
      "permanent": true
    },
    {
      "source": "/product/:slug*",
      "destination": "/producto/:slug*",
      "permanent": true
    },
    {
      "source": "/p/:slug*",
      "destination": "/producto/:slug*",
      "permanent": true
    },
    {
      "source": "/temas/:slug*",
      "destination": "/themes/:slug*",
      "permanent": true
    },
    {
      "source": "/temas",
      "destination": "/themes",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/page/nosotros",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/page/terminos",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/page/pol-ticas-de-privacidad",
      "permanent": true
    },
    {
      "source": "/help",
      "destination": "/page/condiciones-de-compra",
      "permanent": true
    },
    {
      "source": "/importaciones",
      "destination": "/import-hub",
      "permanent": true
    },
    {
      "source": "/franquicias",
      "destination": "/import-hub",
      "permanent": true
    },
    {
      "source": "/franquicia",
      "destination": "/import-hub",
      "permanent": true
    },
    {
      "source": "/product-tag/:tag*",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/tag/:tag*",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/store/:slug*",
      "destination": "/shop",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap?type=index"
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/api/sitemap?type=index"
    },
    {
      "source": "/sitemap-products.xml",
      "destination": "/api/sitemap?type=products"
    },
    {
      "source": "/sitemap-categories.xml",
      "destination": "/api/sitemap?type=categories"
    },
    {
      "source": "/sitemap-brands.xml",
      "destination": "/api/sitemap?type=brands"
    },
    {
      "source": "/sitemap-academy.xml",
      "destination": "/api/sitemap?type=academy"
    },
    {
      "source": "/sitemap-pages.xml",
      "destination": "/api/sitemap?type=pages"
    },
    {
      "source": "/sitemap-:slug*",
      "destination": "/api/sitemap?type=unknown"
    },
    {
      "source": "/sitemap_:slug*",
      "destination": "/api/sitemap?type=unknown"
    },
    {
      "source": "/merchant-feed.xml",
      "destination": "/api/merchant-feed"
    },
    {
      "source": "/meta-catalog.csv",
      "destination": "/api/meta-catalog"
    },
    {
      "source": "/catalog-images/:path*",
      "destination": "/api/catalog-image?path=:path*"
    },
    {
      "source": "/api/gsc-monitor",
      "destination": "/api/gsc-monitor.js"
    },
    {
      "source": "/api/gsc-monitor/:path*",
      "destination": "/api/gsc-monitor.js"
    },
    {
      "source": "/sample-page:slug*",
      "destination": "/api/seo-prerender?type=wp_garbage"
    },
    {
      "source": "/wp-includes/:slug*",
      "destination": "/api/seo-prerender?type=wp_garbage"
    },
    {
      "source": "/wp-content/:slug*",
      "destination": "/api/seo-prerender?type=wp_garbage"
    },
    {
      "source": "/wp-:slug*",
      "destination": "/api/seo-prerender?type=wp_garbage"
    },
    {
      "source": "/feed:slug*",
      "destination": "/api/seo-prerender?type=wp_garbage"
