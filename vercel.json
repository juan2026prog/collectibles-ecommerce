{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/brand/:slug*",
      "destination": "/marca/:slug*",
      "permanent": true
    },
    {
      "source": "/product-category/:slug*",
      "destination": "/categoria/:slug*",
      "permanent": true
    },
    {
      "source": "/product/:slug*",
      "destination": "/producto/:slug*",
      "permanent": true
    },
    {
      "source": "/product-tag/:tag*",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/tag/:tag*",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/store/:slug*",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/wishlist",
      "destination": "/cart",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/merchant-feed.xml",
      "destination": "/api/merchant-feed"
    },
    {
      "source": "/meta-catalog.csv",
      "destination": "/api/meta-catalog"
    },
    {
      "source": "/catalog-images/(.*)",
      "destination": "/api/catalog-image?path=$1"
    },
    {
      "source": "/p/:slug*",
      "destination": "/api/seo-prerender"
    },
    {
      "source": "/producto/:slug*",
      "destination": "/api/seo-prerender"
    },
    {
      "source": "/categoria/:slug*",
      "destination": "/api/seo-prerender"
    },
    {
      "source": "/marca/:slug*",
      "destination": "/api/seo-prerender"
    },
    {
      "source": "/page/:slug*",
      "destination": "/api/seo-prerender"
    },
    {
      "source": "/contact",
      "destination": "/api/seo-prerender"
    },
    {
      "source": "/shop",
      "destination": "/api/seo-prerender"
    },
    {
      "source": "/",
      "destination": "/api/seo-prerender"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
